# App
APP_ENV=development
LOG_LEVEL=debug

# Ports
API_GATEWAY_PORT=8080
USER_SERVICE_GRPC_PORT=50051
CONTENT_SERVICE_GRPC_PORT=50052
FEED_SERVICE_GRPC_PORT=50053
NOTIFICATION_SERVICE_GRPC_PORT=50054
STORAGE_SERVICE_GRPC_PORT=50055

# Database
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require

# Redis
REDIS_ADDR=redis:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# JWT
JWT_SECRET=change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Internal gRPC addresses for Docker Compose
USER_SERVICE_GRPC_ADDR=user-service:50051
CONTENT_SERVICE_GRPC_ADDR=content-service:50052
FEED_SERVICE_GRPC_ADDR=feed-service:50053
NOTIFICATION_SERVICE_GRPC_ADDR=notification-service:50054
STORAGE_SERVICE_GRPC_ADDR=storage-service:50055

# Supabase Storage
SUPABASE_STORAGE_BUCKET=threadly-media
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_PUBLIC_STORAGE_URL=